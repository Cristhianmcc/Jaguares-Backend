# Backend - Academia Deportiva
# Este archivo debe estar en la RAÍZ del proyecto o en /server

# ============================================
# CONFIGURACIÓN APPS SCRIPT (REQUERIDO)
# ============================================
# URL del Web App desplegado en Google Apps Script
APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_DESPLIEGUE/exec

# Token de seguridad para autenticar las peticiones
# IMPORTANTE: Este token NO debe estar en el frontend
# Cambia este valor por uno nuevo y único
APPS_SCRIPT_TOKEN=reemplaza_con_un_token_seguro

# ============================================
# CONFIGURACIÓN OPCIONAL (LEGACY)
# ============================================
# Las siguientes variables son para compatibilidad con el sistema anterior
# Si no las usas, puedes eliminarlas

# Credenciales de Google Service Account (legacy)
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_CLIENT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com

# IDs de Google Sheets (legacy)
# VITE_SPREADSHEET_ID=1hCbcC82oeY4auvQ6TC4FdmWcfr35Cnw-EJcPg8B8MCg
# VITE_SPREADSHEET_ID_BACKUP=1Xp8VI8CulkMZMiOc1RzopFLrwL6FnTQ5a3_gskMpbcY

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================

PORT=3002
NODE_ENV=development
JWT_SECRET=reemplaza_con_una_clave_de_al_menos_32_caracteres

# Base de datos principal del entorno donde se despliega
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=reemplaza_con_la_clave_de_mysql
DB_NAME=jaguares_db

# Solo lo usa docker-compose.dev.yml para crear la copia local
DB_ROOT_PASSWORD=reemplaza_con_otra_clave_local

# Biblioteca persistente del CMS. En Docker, monta este directorio como volumen.
CMS_UPLOADS_DIR=./uploads/landing
# Opcional en producción, por ejemplo: https://tudominio.com
CMS_MEDIA_BASE_URL=
